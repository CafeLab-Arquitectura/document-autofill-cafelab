# Copia este archivo como .env y completa los valores. Nunca subas el .env.

# Document AI (ver docs/fase-0-google-cloud.md)
GCP_PROJECT_ID=
# us o eu
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=
# Opcional: si se deja vacío, se usa la versión predeterminada del procesador
DOCAI_PROCESSOR_VERSION=
# Ruta absoluta al JSON de la cuenta de servicio, fuera del repositorio
GOOGLE_APPLICATION_CREDENTIALS=
DOCAI_TIMEOUT_SECONDS=10

# PostgreSQL: DESACTIVADO, el servicio no usa base de datos.
# Si se reactiva la persistencia (ver app/infrastructure/persistence/__init__.py):
# DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:6543/postgres?sslmode=require

# Reglas del servicio
CONFIDENCE_THRESHOLD=0.7
MAX_FILE_MB=10

# Servidor
PORT=8000
